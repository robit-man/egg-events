[Unit]
Description=Qwen3-Omni comprehension worker for the Egg companion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@VENDOR_DIR@
# Started and stopped on demand by the companion's residency manager, which
# admits it only when its measured footprint genuinely fits. Do not enable
# this unit: booting it unconditionally is what over-commits the module.
#
# Pick the largest context that fits MemAvailable at each load, while retaining
# the same reserve used by the residency manager. The configured token value is
# a ceiling, not a promise to over-commit unified memory.
Environment=OMNI_COMPREHENSION_CONTEXT_TOKENS=@CONTEXT_TOKENS@
Environment=OMNI_COMPREHENSION_MIN_CONTEXT_TOKENS=4096
Environment=OMNI_COMPREHENSION_MEMORY_RESERVE_GIB=3.0
Environment=OMNI_COMPREHENSION_PARALLEL=1
Environment=OMNI_COMPREHENSION_CONTEXT_FILE=%t/egg-omni-comprehension-context
ExecStart=@VENDOR_DIR@/.venv/bin/python \
  @VENDOR_DIR@/runtime/comprehension_launcher.py \
  --state-file %t/egg-omni-comprehension-context -- \
  @VENDOR_DIR@/vendor/llama.cpp/build/bin/llama-server \
  -m @VENDOR_DIR@/runtime-data/components/comprehension-model.gguf \
  --mmproj @VENDOR_DIR@/runtime-data/components/comprehension-projector.gguf \
  --host 127.0.0.1 --port 8901 --jinja -ngl 99 -c {context} \
  --parallel {parallel} \
  --threads 4 --threads-batch 4 --poll 0 --poll-batch 0
Restart=no
TimeoutStopSec=60
UMask=0077
# Above the measured footprint with room for the load-time peak. The residency
# manager is what prevents over-commit; this is only a backstop, and a cap that
# kills the worker mid-utterance is worse than no cap at all.
MemoryMax=26G
