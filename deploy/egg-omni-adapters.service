[Unit]
Description=Qwen Omni adapter for the Egg companion
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@VENDOR_DIR@
Environment=OMNI_REPO_ROOT=@VENDOR_DIR@
Environment=OMNI_MODEL=@OMNI_MODEL@
Environment=OMNI_LANGUAGE_MODEL=@LANGUAGE_MODEL@
# ASR and language use the same externally managed comprehension worker. No
# second Ollama runner is loaded for the language step.
Environment=OMNI_LANGUAGE_API=openai
Environment=OMNI_LANGUAGE_URL=http://127.0.0.1:8901/v1/chat/completions
Environment=OMNI_ADAPTER_PORT=@ADAPTER_PORT@
Environment=OMNI_KEEP_CACHE=1
# The host residency manager owns the 16.7 GiB comprehension worker. The
# adapter only points at it; starting this unit must never start weights.
Environment=OMNI_ENABLE_COMPREHENSION=0
Environment=OMNI_COMPREHENSION_URL=http://127.0.0.1:8901/v1/chat/completions
Environment=OMNI_COMPREHENSION_CONTEXT_TOKENS=@CONTEXT_TOKENS@
# The TTS worker exits between utterances instead of staying resident, so its
# ~4 GiB is only held while actually speaking.
Environment=OMNI_TTS_PERSISTENT=0
# The portable daemon's normal gate generates language and TTS at startup.
# Those real loads bypass host admission control, so a brokered service uses
# lightweight readiness probes and exercises each stage only after admission.
Environment=OMNI_STARTUP_SMOKE=0
# llama.cpp defaults to active polling and all host cores. On an integrated
# Jetson that burns CPU while waiting and competes with audio/camera capture.
Environment=LLAMA_ARG_THREADS=4
Environment=LLAMA_ARG_THREADS_BATCH=4
Environment=LLAMA_ARG_POLL=0
Environment=LLAMA_ARG_POLL_BATCH=0
Environment=PYTHONUNBUFFERED=1
ExecStart=@VENDOR_DIR@/.venv/bin/qwen-omni-daemon serve --allow-direct-gpu --no-tunnel
Restart=on-failure
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=120
UMask=0077
# A hard ceiling so a misconfigured component is killed by systemd instead of
# taking the whole machine down with it, as an unbounded load already did once.
MemoryMax=12G
MemorySwapMax=2G

[Install]
WantedBy=default.target
